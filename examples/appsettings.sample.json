{
  "Urls": "http://127.0.0.1:5088",
  "JLogDashboard": {
    "RoutePrefix": "/jlog",
    "Culture": "zh-CN",
    "DefaultPageSize": 50,
    "MaxPageSize": 500,
    "MaxFileBytes": 10485760,
    "BasicAuth": {
      "Enabled": true,
      "Username": "admin",
      "Password": "",
      "PasswordSha256": "replace-with-sha256-hex",
      "Realm": "JLogDashboard",
      "MaxFailedAttempts": 5,
      "LockoutSeconds": 300
    },
    "Projects": [
      {
        "Name": "orders",
        "DirectoryPath": "/var/log/orders",
        "Provider": "serilog",
        "FileSearchPattern": "*.log",
        "Recursive": false
      },
      {
        "Name": "billing",
        "DirectoryPath": "/var/log/billing",
        "Provider": "nlog",
        "FileSearchPattern": "*.log",
        "Recursive": true
      }
    ]
  }
}
