{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JLogDashboard": {
    "RoutePrefix": "/jlog",
    "Culture": "zh-CN",
    "DefaultPageSize": 50,
    "MaxPageSize": 500,
    "MaxFileBytes": 10485760,
    "BasicAuth": {
      "Enabled": true,
      "Username": "admin",
      "Password": "change-me",
      "PasswordSha256": "",
      "Realm": "JLogDashboard",
      "MaxFailedAttempts": 5,
      "LockoutSeconds": 300
    },
    "Projects": [
      {
        "Name": "sample",
        "DirectoryPath": "C:\\logs\\sample",
        "Provider": "auto",
        "FileSearchPattern": "*.log",
        "Recursive": false
      }
    ]
  },
  "AllowedHosts": "*"
}
