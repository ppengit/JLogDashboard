<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>JLogDashboard</PackageId>
    <VersionPrefix>0.1.3</VersionPrefix>
    <Title>JLogDashboard</Title>
    <Authors>penjay</Authors>
    <Company>penjay</Company>
    <Copyright>Copyright (c) 2026 penjay (peng.it@qq.com)</Copyright>
    <Description>Lightweight ASP.NET Core log dashboard for browsing NLog, log4net, and Serilog file logs across multiple .NET projects.</Description>
    <PackageReleaseNotes>Documentation and package presentation refresh for public release readiness, plus improved Basic Auth lockout behavior for anonymous requests.</PackageReleaseNotes>
    <PackageTags>logging;logviewer;dashboard;aspnetcore;nlog;log4net;serilog;operations;observability;devops</PackageTags>
    <PackageProjectUrl>https://github.com/ppengit/JLogDashboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ppengit/JLogDashboard.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

</Project>
