<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>JLogDashboard</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Title>JLogDashboard</Title>
    <Authors>penjay</Authors>
    <Company>penjay</Company>
    <Copyright>Copyright (c) 2026 penjay (peng.it@qq.com)</Copyright>
    <Description>Lightweight ASP.NET Core log dashboard for browsing NLog, log4net, and Serilog file logs across multiple .NET projects.</Description>
    <PackageReleaseNotes>Hardened fault isolation so the fault-isolation endpoint filter is the outermost guard, containing configuration, authentication, model-binding, and handler failures. Preserved correct 400 responses for malformed search requests. Hardened configuration analysis and the Basic Auth guard against null BasicAuth, parser, and project entries. Hardened startup diagnostics so logging failures cannot prevent the host application from starting.</PackageReleaseNotes>
    <PackageTags>logging;logviewer;dashboard;aspnetcore;nlog;log4net;serilog;operations;observability;devops</PackageTags>
    <PackageProjectUrl>https://github.com/ppengit/JLogDashboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ppengit/JLogDashboard.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
    <None Include="..\..\README.zh-CN.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.zh-CN.md')" />
  </ItemGroup>

</Project>
